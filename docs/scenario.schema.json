{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "referenceIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "initialEquity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "transactions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "adjustment": {
            "type": "boolean"
          },
          "referenceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entries": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "side": {
                  "type": "string",
                  "enum": [
                    "debit",
                    "credit"
                  ]
                },
                "accountId": {
                  "type": "string",
                  "minLength": 1
                },
                "amount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              },
              "required": [
                "side",
                "accountId",
                "amount"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "date",
          "description",
          "adjustment",
          "referenceIds",
          "entries"
        ],
        "additionalProperties": false
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "unadjustedDebit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "unadjustedCredit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "adjustedDebit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "adjustedCredit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "assets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "liabilities": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "revenue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "expenses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "profit": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "endingEquity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "unadjustedDebit",
        "unadjustedCredit",
        "adjustedDebit",
        "adjustedCredit",
        "assets",
        "liabilities",
        "revenue",
        "expenses",
        "profit",
        "endingEquity"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "title",
    "assumptions",
    "referenceIds",
    "initialEquity",
    "transactions",
    "expected"
  ],
  "additionalProperties": false
}
