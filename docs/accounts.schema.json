{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "type": "string",
        "enum": [
          "asset",
          "contraAsset",
          "liability",
          "equity",
          "revenue",
          "expense",
          "clearing"
        ]
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "referenceIds": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "id",
      "name",
      "type",
      "description",
      "referenceIds"
    ],
    "additionalProperties": false
  }
}
